    "Двойное касание дужки или кнопка камеры вызывают ассистента и перебивают ответ. Это пробная возможность очков: что именно приходит с ваших очков, видно в журнале. Одиночное касание и удержание очки оставляют себе.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tapping the temple or pressing the camera button calls the assistant and interrupts an answer. This is an experimental glasses feature: the Log shows exactly what your glasses send. Single tap and touch and hold stay with the glasses."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Koʻzoynak bandiga ikki marta tegish yoki kamera tugmasi yordamchini chaqiradi va javobini boʻladi. Bu koʻzoynakning sinov imkoniyati: koʻzoynagingizdan aynan nima kelayotgani jurnalda koʻrinadi. Bir marta tegish va bosib turish esa koʻzoynakning oʻzida qoladi."
          }
        }
      }
    },
    "Действия переводчика": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translator actions"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjimon amallari"
          }
        }
      }
    },
    "Действия с журналом": {
