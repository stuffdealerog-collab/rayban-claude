          }
        }
      }
    },
    "Память, ключи и разговоры сохранятся.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory, keys, and conversations will be kept."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xotira, kalitlar va suhbatlar saqlanib qoladi."
          }
        }
      }
    },
    "Папка %@": {
      "extractionState": "manual",
      "localizations": {
