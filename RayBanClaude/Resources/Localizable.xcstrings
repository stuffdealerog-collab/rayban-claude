    "Выбранный голос ElevenLabs работает только на платном тарифе. Выберите стандартный голос: Настройки → Голос. Пока говорю голосом iOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected ElevenLabs voice needs a paid plan. Choose a standard voice: Settings → Voice. For now I speak with the iOS voice."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlangan ElevenLabs ovozi faqat pullik tarifda ishlaydi. Standart ovozni tanlang: Sozlamalar → Ovoz. Hozircha iOS ovozida gapiraman."
          }
        }
      }
    },
    "Выразительная (v4)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
