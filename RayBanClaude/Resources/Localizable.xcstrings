    "Остановить ответ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop answer"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Javobni toʻxtatish"
          }
        }
      }
    },
    "Остроумный: шутит к месту, но дело делает всерьёз": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick-witted: jokes when it fits, but takes the work seriously"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozirjavob: oʻrnida hazillashadi, ammo ishni jiddiy bajaradi"
          }
        }
      }
    },
    "Отбой": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hang up"
          }
        },
        "uz": {
