            "state": "translated",
            "value": "Bir soatdan keyin onamga qoʻngʻiroq qilishni eslatib qoʻy"
          }
        }
      }
    },
    "Например, Обо мне": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example, About me"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Masalan, Men haqimda"
          }
        }
      }
    },
    "Например: спокойный, говорит как старый друг, немного философ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: calm, talks like an old friend, a bit of a philosopher"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Masalan: xotirjam, eski qadrdon doʻstdek gapiradi, biroz faylasuf"
