    "Здесь %@ хранит то, что узнаёт о вас": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is where %@ keeps what it learns about you"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ siz haqingizda bilib olganlarini shu yerda saqlaydi"
          }
        }
      }
    },
    "Из фона ассистент может только позвонить вам — принять вызов нужно касанием очков или на экране.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the background, the assistant can only call you — answer the call by tapping your glasses or on the screen."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Fon rejimida yordamchi sizga faqat qoʻngʻiroq qila oladi — qoʻngʻiroqni koʻzoynakka tegib yoki ekranda qabul qilish kerak."
          }
        }
      }
    },
