    },
    "голос iOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS voice"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ovozi"
          }
        }
      }
    },
    "голос из библиотеки ElevenLabs работает только на платном тарифе.": {
      "extractionState": "manual",
      "localizations": {
