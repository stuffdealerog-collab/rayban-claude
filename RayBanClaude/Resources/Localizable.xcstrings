            "state": "translated",
            "value": "Photo from glasses camera"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Koʻzoynak kamerasidan olingan surat"
          }
        }
      }
    },
    "Собеседник": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other person"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhbatdosh"
          }
        }
      }
    },
    "Собеседнику — из динамика телефона": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the other person — phone speaker"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhbatdoshga — telefon dinamigidan"
          }
        }
      }
    },
    "Собранный и точный: говорит по делу, без лишних эмоций": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composed and precise: speaks to the point, without extra emotion"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazmin va aniq: loʻnda gapiradi, ortiqcha his-hayajonsiz"
          }
        }
      }
    },
    "События появятся, как только вы начнёте разговор.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events appear as soon as you start a conversation."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodisalar suhbatni boshlashingiz bilan paydo boʻladi."
          }
        }
      }
    },
    "Соединяю": {
