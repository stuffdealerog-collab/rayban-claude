      }
    },
    "Слышит вас через очки Ray-Ban Meta и отвечает голосом. Видит их камерой, помнит вас, ведёт календарь и почту, переводит разговор. Сначала придумайте, каким он будет.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hears you through your Ray-Ban Meta glasses and answers by voice. Sees through their camera, remembers you, manages your calendar and mail, and translates conversations. First, decide what it will be like."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizni Ray-Ban Meta koʻzoynagi orqali eshitadi va ovoz bilan javob beradi. Koʻzoynak kamerasi orqali koʻradi, sizni eslab qoladi, taqvim va pochtangizni yuritadi, suhbatni tarjima qiladi. Avval uning qanday boʻlishini oʻylab toping."
          }
        }
      }
    },
    "Смешанная речь": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixed speech"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Aralash nutq"
          }
        }
      }
    },
    "Смотрю календарь": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking calendar"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taqvimga qarayapman"
          }
        }
      }
    },
